# Server Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:8080

# Audio Processing
MAX_FILE_SIZE=10485760
AUDIO_QUALITY=128
TEMP_DIR=./tmp

# AcoustID Configuration
ACOUSTID_API_KEY=your-acoustid-api-key
ACOUSTID_CLIENT_ID=your-client-id
ACOUSTID_ENDPOINT=https://api.acoustid.org/v2

# MusicBrainz Configuration
MUSICBRAINZ_ENDPOINT=https://musicbrainz.org/ws/2
MUSICBRAINZ_USER_AGENT=SearchByVoice/1.0

# Logging
LOG_LEVEL=info
